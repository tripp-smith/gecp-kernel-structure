import GECPKernelStructure.Matrix.WeightedCenteredGroups
import GECPKernelStructure.Matrix.FinTwoPencil

namespace Matrix

open Finset

variable {ι : Type*}

/-- The product of a left and right `2 x 2` feature coordinate, written in
terms of their four scalar rows. -/
noncomputable def rankTwoMatchedCoordinate
    (leftZero leftOne rightZero rightOne : ι → ℝ) (i j : ι) : ℝ :=
  (leftZero i * leftOne j - leftZero j * leftOne i) *
    (rightZero i * rightOne j - rightZero j * rightOne i)

/-- The product of the left and right `2 x 2` coordinates generated by two
affine ratio factorizations.  The left feature column at `k` is
`a k * (1, f k)` and the right feature row is `b k * (1, g k)`. -/
noncomputable def affineRankTwoMatchedCoordinate
    (a f b g : ι → ℝ) (i j : ι) : ℝ :=
  (a i * (a j * f j) - a j * (a i * f i)) *
    (b i * (b j * g j) - b j * (b i * g i))

/-- A matched affine rank-two coordinate is a positive-pair weight times the
product of its two ratio increments. -/
theorem affineRankTwoMatchedCoordinate_eq
    (a f b g : ι → ℝ) (i j : ι) :
    affineRankTwoMatchedCoordinate a f b g i j =
      (a i * b i) * (a j * b j) * (f j - f i) * (g j - g i) := by
  unfold affineRankTwoMatchedCoordinate
  ring

/-- Entrywise affine ratio certificates rewrite an arbitrary matched
rank-two coordinate into the canonical ratio form without introducing
division. -/
theorem rankTwoMatchedCoordinate_eq_affine
    (leftZero leftOne rightZero rightOne f g : ι → ℝ)
    (left_factor : ∀ k, leftOne k = leftZero k * f k)
    (right_factor : ∀ k, rightOne k = rightZero k * g k)
    (i j : ι) :
    rankTwoMatchedCoordinate leftZero leftOne rightZero rightOne i j =
      affineRankTwoMatchedCoordinate leftZero f rightZero g i j := by
  simp only [rankTwoMatchedCoordinate, affineRankTwoMatchedCoordinate,
    left_factor, right_factor]

/-- The within-block coefficient of an affine rank-two pairing.  The factor
`1 / 2` removes the duplication from ordered pairs. -/
noncomputable def affineRankTwoWithinCoefficient
    (s : Finset ι) (a f b g : ι → ℝ) : ℝ :=
  (1 / 2 : ℝ) *
    ∑ i ∈ s, ∑ j ∈ s, affineRankTwoMatchedCoordinate a f b g i j

/-- The within-block rank-two coefficient is exactly a weighted covariance
numerator with singleton weight `a k * b k`. -/
theorem affineRankTwoWithinCoefficient_eq_weightedCovarianceNumerator
    (s : Finset ι) (a f b g : ι → ℝ) :
    affineRankTwoWithinCoefficient s a f b g =
      weightedCovarianceNumerator s (fun k ↦ a k * b k) f g := by
  unfold affineRankTwoWithinCoefficient
  simp_rw [affineRankTwoMatchedCoordinate_eq]
  have increment_swap :
      (∑ i ∈ s, ∑ j ∈ s,
        (a i * b i) * (a j * b j) * (f j - f i) * (g j - g i)) =
      ∑ i ∈ s, ∑ j ∈ s,
        (a i * b i) * (a j * b j) * (f i - f j) * (g i - g j) := by
    apply sum_congr rfl
    intro i hi
    apply sum_congr rfl
    intro j hj
    ring
  rw [increment_swap]
  rw [← two_mul_weightedCovarianceNumerator]
  ring

/-- The cross-block coefficient of an affine rank-two pairing. -/
noncomputable def affineRankTwoCrossCoefficient
    (lower upper : Finset ι) (a f b g : ι → ℝ) : ℝ :=
  ∑ i ∈ lower, ∑ j ∈ upper,
    affineRankTwoMatchedCoordinate a f b g i j

/-- The cross-block rank-two coefficient is exactly the weighted
cross-increment sum with singleton weight `a k * b k`. -/
theorem affineRankTwoCrossCoefficient_eq_weightedCrossIncrement
    (lower upper : Finset ι) (a f b g : ι → ℝ) :
    affineRankTwoCrossCoefficient lower upper a f b g =
      weightedCrossIncrement lower upper (fun k ↦ a k * b k) f g := by
  unfold affineRankTwoCrossCoefficient weightedCrossIncrement
  simp_rw [affineRankTwoMatchedCoordinate_eq]

/-- Within-block coefficient for arbitrary scalar rows of two rank-two
factors. -/
noncomputable def rankTwoWithinCoefficient
    (s : Finset ι)
    (leftZero leftOne rightZero rightOne : ι → ℝ) : ℝ :=
  (∑ k ∈ s, leftZero k * rightZero k) *
      (∑ k ∈ s, leftOne k * rightOne k) -
    (∑ k ∈ s, leftZero k * rightOne k) *
      (∑ k ∈ s, leftOne k * rightZero k)

/-- Cross-block coefficient for arbitrary scalar rows of two rank-two
factors. -/
noncomputable def rankTwoCrossCoefficient
    (lower upper : Finset ι)
    (leftZero leftOne rightZero rightOne : ι → ℝ) : ℝ :=
  (∑ k ∈ lower, leftZero k * rightZero k) *
      (∑ k ∈ upper, leftOne k * rightOne k) +
    (∑ k ∈ upper, leftZero k * rightZero k) *
      (∑ k ∈ lower, leftOne k * rightOne k) -
    (∑ k ∈ lower, leftZero k * rightOne k) *
      (∑ k ∈ upper, leftOne k * rightZero k) -
    (∑ k ∈ upper, leftZero k * rightOne k) *
      (∑ k ∈ lower, leftOne k * rightZero k)

/-- Sum of feature-indexed rank-one outer products, displayed as a `2 x 2`
matrix through its four scalar rows. -/
noncomputable def rankTwoBlockMatrix
    (s : Finset ι)
    (leftZero leftOne rightZero rightOne : ι → ℝ) :
    Matrix (Fin 2) (Fin 2) ℝ :=
  ![
    ![∑ k ∈ s, leftZero k * rightZero k,
      ∑ k ∈ s, leftZero k * rightOne k],
    ![∑ k ∈ s, leftOne k * rightZero k,
      ∑ k ∈ s, leftOne k * rightOne k]
  ]

/-- Rank-two Cauchy--Binet in scalar-row form. -/
theorem rankTwoBlockMatrix_det
    (s : Finset ι)
    (leftZero leftOne rightZero rightOne : ι → ℝ) :
    (rankTwoBlockMatrix s leftZero leftOne rightZero rightOne).det =
      rankTwoWithinCoefficient s leftZero leftOne rightZero rightOne := by
  rw [Matrix.det_fin_two]
  unfold rankTwoBlockMatrix rankTwoWithinCoefficient
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one]

/-- The mixed determinant coefficient between two feature blocks is their
cross-block sum of matched rank-two coordinates. -/
theorem finTwoPencilMixed_rankTwoBlockMatrix
    (lower upper : Finset ι)
    (leftZero leftOne rightZero rightOne : ι → ℝ) :
    finTwoPencilMixed
        (rankTwoBlockMatrix lower leftZero leftOne rightZero rightOne)
        (rankTwoBlockMatrix upper leftZero leftOne rightZero rightOne) =
      rankTwoCrossCoefficient lower upper
        leftZero leftOne rightZero rightOne := by
  unfold finTwoPencilMixed rankTwoBlockMatrix rankTwoCrossCoefficient
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one]

theorem rankTwoWithinCoefficient_eq_affine
    (s : Finset ι)
    (leftZero leftOne rightZero rightOne f g : ι → ℝ)
    (left_factor : ∀ k, leftOne k = leftZero k * f k)
    (right_factor : ∀ k, rightOne k = rightZero k * g k) :
    rankTwoWithinCoefficient s leftZero leftOne rightZero rightOne =
      affineRankTwoWithinCoefficient s leftZero f rightZero g := by
  rw [affineRankTwoWithinCoefficient_eq_weightedCovarianceNumerator]
  unfold rankTwoWithinCoefficient weightedCovarianceNumerator weightedMass
    weightedMoment
  simp_rw [left_factor, right_factor]
  have sum_f (t : Finset ι) :
      (∑ k ∈ t, leftZero k * f k * rightZero k) =
        ∑ k ∈ t, leftZero k * rightZero k * f k := by
    apply sum_congr rfl
    intro k hk
    ring
  have sum_fg (t : Finset ι) :
      (∑ k ∈ t, leftZero k * f k * (rightZero k * g k)) =
        ∑ k ∈ t, leftZero k * rightZero k * f k * g k := by
    apply sum_congr rfl
    intro k hk
    ring
  have sum_g (t : Finset ι) :
      (∑ k ∈ t, leftZero k * (rightZero k * g k)) =
        ∑ k ∈ t, leftZero k * rightZero k * g k := by
    apply sum_congr rfl
    intro k hk
    ring
  rw [sum_f, sum_fg, sum_g]
  ring

theorem rankTwoCrossCoefficient_eq_affine
    (lower upper : Finset ι)
    (leftZero leftOne rightZero rightOne f g : ι → ℝ)
    (left_factor : ∀ k, leftOne k = leftZero k * f k)
    (right_factor : ∀ k, rightOne k = rightZero k * g k) :
    rankTwoCrossCoefficient lower upper
        leftZero leftOne rightZero rightOne =
      affineRankTwoCrossCoefficient lower upper leftZero f rightZero g := by
  rw [affineRankTwoCrossCoefficient_eq_weightedCrossIncrement,
    weightedCrossIncrement_eq]
  unfold rankTwoCrossCoefficient weightedMass weightedMoment
  simp_rw [left_factor, right_factor]
  have sum_f (t : Finset ι) :
      (∑ k ∈ t, leftZero k * f k * rightZero k) =
        ∑ k ∈ t, leftZero k * rightZero k * f k := by
    apply sum_congr rfl
    intro k hk
    ring
  have sum_fg (t : Finset ι) :
      (∑ k ∈ t, leftZero k * f k * (rightZero k * g k)) =
        ∑ k ∈ t, leftZero k * rightZero k * f k * g k := by
    apply sum_congr rfl
    intro k hk
    ring
  have sum_g (t : Finset ι) :
      (∑ k ∈ t, leftZero k * (rightZero k * g k)) =
        ∑ k ∈ t, leftZero k * rightZero k * g k := by
    apply sum_congr rfl
    intro k hk
    ring
  rw [sum_f lower, sum_f upper, sum_fg lower, sum_fg upper,
    sum_g lower, sum_g upper]
  ring

variable [DecidableEq ι]

/-- A positive ordered affine chart for two rank-two factors gives the sharp
Lorentzian inequality for every threshold split.  The theorem contains no
division: a later projective argument only needs to supply the four chart
coordinates and their sign/order certificates. -/
theorem affineRankTwoCoefficients_lorentzian
    (lower upper : Finset ι) (a f b g : ι → ℝ)
    (lower_mass_pos : 0 < weightedMass lower (fun k ↦ a k * b k))
    (upper_mass_pos : 0 < weightedMass upper (fun k ↦ a k * b k))
    (weight_nonneg : ∀ k ∈ lower ∪ upper, 0 ≤ a k * b k)
    (lower_monovary : MonovaryOn f g lower)
    (upper_monovary : MonovaryOn f g upper)
    (f_cross : ∀ i ∈ lower, ∀ j ∈ upper, f i ≤ f j)
    (g_cross : ∀ i ∈ lower, ∀ j ∈ upper, g i ≤ g j) :
    4 * affineRankTwoWithinCoefficient lower a f b g *
        affineRankTwoWithinCoefficient upper a f b g ≤
      affineRankTwoCrossCoefficient lower upper a f b g ^ 2 := by
  rw [affineRankTwoWithinCoefficient_eq_weightedCovarianceNumerator,
    affineRankTwoWithinCoefficient_eq_weightedCovarianceNumerator,
    affineRankTwoCrossCoefficient_eq_weightedCrossIncrement]
  exact four_mul_weightedCovarianceNumerator_mul_le_crossIncrement_sq
    lower upper (fun k ↦ a k * b k) f g lower_mass_pos upper_mass_pos
    weight_nonneg lower_monovary upper_monovary f_cross g_cross

/-- Certificate-oriented form for arbitrary left/right scalar rows.  A
projective chart supplies only the two factorization equalities and the
positivity/order hypotheses; the resulting coefficient inequality is stated
for the original, unnormalized rank-two coordinates. -/
theorem rankTwoCoefficients_lorentzian_of_affine
    (lower upper : Finset ι)
    (leftZero leftOne rightZero rightOne f g : ι → ℝ)
    (left_factor : ∀ k, leftOne k = leftZero k * f k)
    (right_factor : ∀ k, rightOne k = rightZero k * g k)
    (lower_mass_pos :
      0 < weightedMass lower (fun k ↦ leftZero k * rightZero k))
    (upper_mass_pos :
      0 < weightedMass upper (fun k ↦ leftZero k * rightZero k))
    (weight_nonneg :
      ∀ k ∈ lower ∪ upper, 0 ≤ leftZero k * rightZero k)
    (lower_monovary : MonovaryOn f g lower)
    (upper_monovary : MonovaryOn f g upper)
    (f_cross : ∀ i ∈ lower, ∀ j ∈ upper, f i ≤ f j)
    (g_cross : ∀ i ∈ lower, ∀ j ∈ upper, g i ≤ g j) :
    4 * rankTwoWithinCoefficient lower
          leftZero leftOne rightZero rightOne *
        rankTwoWithinCoefficient upper
          leftZero leftOne rightZero rightOne ≤
      rankTwoCrossCoefficient lower upper
          leftZero leftOne rightZero rightOne ^ 2 := by
  rw [rankTwoWithinCoefficient_eq_affine _ _ _ _ _ _ _
      left_factor right_factor,
    rankTwoWithinCoefficient_eq_affine _ _ _ _ _ _ _
      left_factor right_factor,
    rankTwoCrossCoefficient_eq_affine _ _ _ _ _ _ _ _
      left_factor right_factor]
  exact affineRankTwoCoefficients_lorentzian lower upper leftZero f rightZero g
    lower_mass_pos upper_mass_pos weight_nonneg lower_monovary upper_monovary
    f_cross g_cross

/-- Matrix-pencil form of the projective ratio certificate.  This is the
direct interface to the fresh-order-two quadratic factorization theorem. -/
theorem rankTwoBlockPencil_lorentzian_of_affine
    (lower upper : Finset ι)
    (leftZero leftOne rightZero rightOne f g : ι → ℝ)
    (left_factor : ∀ k, leftOne k = leftZero k * f k)
    (right_factor : ∀ k, rightOne k = rightZero k * g k)
    (lower_mass_pos :
      0 < weightedMass lower (fun k ↦ leftZero k * rightZero k))
    (upper_mass_pos :
      0 < weightedMass upper (fun k ↦ leftZero k * rightZero k))
    (weight_nonneg :
      ∀ k ∈ lower ∪ upper, 0 ≤ leftZero k * rightZero k)
    (lower_monovary : MonovaryOn f g lower)
    (upper_monovary : MonovaryOn f g upper)
    (f_cross : ∀ i ∈ lower, ∀ j ∈ upper, f i ≤ f j)
    (g_cross : ∀ i ∈ lower, ∀ j ∈ upper, g i ≤ g j) :
    4 * (rankTwoBlockMatrix lower
          leftZero leftOne rightZero rightOne).det *
        (rankTwoBlockMatrix upper
          leftZero leftOne rightZero rightOne).det ≤
      finTwoPencilMixed
          (rankTwoBlockMatrix lower
            leftZero leftOne rightZero rightOne)
          (rankTwoBlockMatrix upper
            leftZero leftOne rightZero rightOne) ^ 2 := by
  rw [rankTwoBlockMatrix_det, rankTwoBlockMatrix_det,
    finTwoPencilMixed_rankTwoBlockMatrix]
  exact rankTwoCoefficients_lorentzian_of_affine lower upper
    leftZero leftOne rightZero rightOne f g left_factor right_factor
    lower_mass_pos upper_mass_pos weight_nonneg lower_monovary upper_monovary
    f_cross g_cross

/-- A cutoff-specific projective chart may be used to certify the original
rank-two pencil.  Invertibility transfers the chart inequality back through
the two-sided basis change. -/
theorem rankTwoBlockPencil_lorentzian_of_projective_affine
    (leftBasis rightBasis low high : Matrix (Fin 2) (Fin 2) ℝ)
    (lower upper : Finset ι)
    (leftZero leftOne rightZero rightOne f g : ι → ℝ)
    (left_det_ne : leftBasis.det ≠ 0)
    (right_det_ne : rightBasis.det ≠ 0)
    (low_chart : leftBasis * low * rightBasis =
      rankTwoBlockMatrix lower leftZero leftOne rightZero rightOne)
    (high_chart : leftBasis * high * rightBasis =
      rankTwoBlockMatrix upper leftZero leftOne rightZero rightOne)
    (left_factor : ∀ k, leftOne k = leftZero k * f k)
    (right_factor : ∀ k, rightOne k = rightZero k * g k)
    (lower_mass_pos :
      0 < weightedMass lower (fun k ↦ leftZero k * rightZero k))
    (upper_mass_pos :
      0 < weightedMass upper (fun k ↦ leftZero k * rightZero k))
    (weight_nonneg :
      ∀ k ∈ lower ∪ upper, 0 ≤ leftZero k * rightZero k)
    (lower_monovary : MonovaryOn f g lower)
    (upper_monovary : MonovaryOn f g upper)
    (f_cross : ∀ i ∈ lower, ∀ j ∈ upper, f i ≤ f j)
    (g_cross : ∀ i ∈ lower, ∀ j ∈ upper, g i ≤ g j) :
    4 * low.det * high.det ≤ finTwoPencilMixed low high ^ 2 := by
  have chart_lorentzian := rankTwoBlockPencil_lorentzian_of_affine
    lower upper leftZero leftOne rightZero rightOne f g
    left_factor right_factor lower_mass_pos upper_mass_pos weight_nonneg
    lower_monovary upper_monovary f_cross g_cross
  have transformed_lorentzian :
      4 * (leftBasis * low * rightBasis).det *
          (leftBasis * high * rightBasis).det ≤
        finTwoPencilMixed (leftBasis * low * rightBasis)
          (leftBasis * high * rightBasis) ^ 2 := by
    rw [low_chart, high_chart]
    exact chart_lorentzian
  exact (finTwoPencil_lorentzian_mul_mul_iff
    leftBasis low high rightBasis left_det_ne right_det_ne).mp
      transformed_lorentzian

end Matrix
