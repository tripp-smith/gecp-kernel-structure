import GECPKernelStructure.Matrix.WeightedCenteredGroups
import GECPKernelStructure.Matrix.FinTwoPencil

namespace Matrix

open Finset

variable {ι : Type*}

/-- The product of a left and right `2 x 2` feature coordinate, written in
terms of their four scalar rows. -/
noncomputable def rankTwoMatchedCoordinate
    (leftZero leftOne rightZero rightOne : ι → ℝ) (i j : ι) : ℝ :=
  (leftZero i * leftOne j - leftZero j * leftOne i) *
    (rightZero i * rightOne j - rightZero j * rightOne i)

/-- The product of the left and right `2 x 2` coordinates generated by two
affine ratio factorizations.  The left feature column at `k` is
`a k * (1, f k)` and the right feature row is `b k * (1, g k)`. -/
noncomputable def affineRankTwoMatchedCoordinate
    (a f b g : ι → ℝ) (i j : ι) : ℝ :=
  (a i * (a j * f j) - a j * (a i * f i)) *
    (b i * (b j * g j) - b j * (b i * g i))

/-- A matched affine rank-two coordinate is a positive-pair weight times the
product of its two ratio increments. -/
theorem affineRankTwoMatchedCoordinate_eq
    (a f b g : ι → ℝ) (i j : ι) :
    affineRankTwoMatchedCoordinate a f b g i j =
      (a i * b i) * (a j * b j) * (f j - f i) * (g j - g i) := by
  unfold affineRankTwoMatchedCoordinate
  ring

/-- Entrywise affine ratio certificates rewrite an arbitrary matched
rank-two coordinate into the canonical ratio form without introducing
division. -/
theorem rankTwoMatchedCoordinate_eq_affine
    (leftZero leftOne rightZero rightOne f g : ι → ℝ)
    (left_factor : ∀ k, leftOne k = leftZero k * f k)
    (right_factor : ∀ k, rightOne k = rightZero k * g k)
    (i j : ι) :
    rankTwoMatchedCoordinate leftZero leftOne rightZero rightOne i j =
      affineRankTwoMatchedCoordinate leftZero f rightZero g i j := by
  simp only [rankTwoMatchedCoordinate, affineRankTwoMatchedCoordinate,
    left_factor, right_factor]

/-- The within-block coefficient of an affine rank-two pairing.  The factor
`1 / 2` removes the duplication from ordered pairs. -/
noncomputable def affineRankTwoWithinCoefficient
    (s : Finset ι) (a f b g : ι → ℝ) : ℝ :=
  (1 / 2 : ℝ) *
    ∑ i ∈ s, ∑ j ∈ s, affineRankTwoMatchedCoordinate a f b g i j

/-- The within-block rank-two coefficient is exactly a weighted covariance
numerator with singleton weight `a k * b k`. -/
theorem affineRankTwoWithinCoefficient_eq_weightedCovarianceNumerator
    (s : Finset ι) (a f b g : ι → ℝ) :
    affineRankTwoWithinCoefficient s a f b g =
      weightedCovarianceNumerator s (fun k ↦ a k * b k) f g := by
  unfold affineRankTwoWithinCoefficient
  simp_rw [affineRankTwoMatchedCoordinate_eq]
  have increment_swap :
      (∑ i ∈ s, ∑ j ∈ s,
        (a i * b i) * (a j * b j) * (f j - f i) * (g j - g i)) =
      ∑ i ∈ s, ∑ j ∈ s,
        (a i * b i) * (a j * b j) * (f i - f j) * (g i - g j) := by
    apply sum_congr rfl
    intro i hi
    apply sum_congr rfl
    intro j hj
    ring
  rw [increment_swap]
  rw [← two_mul_weightedCovarianceNumerator]
  ring

/-- The cross-block coefficient of an affine rank-two pairing. -/
noncomputable def affineRankTwoCrossCoefficient
    (lower upper : Finset ι) (a f b g : ι → ℝ) : ℝ :=
  ∑ i ∈ lower, ∑ j ∈ upper,
    affineRankTwoMatchedCoordinate a f b g i j

/-- The cross-block rank-two coefficient is exactly the weighted
cross-increment sum with singleton weight `a k * b k`. -/
theorem affineRankTwoCrossCoefficient_eq_weightedCrossIncrement
    (lower upper : Finset ι) (a f b g : ι → ℝ) :
    affineRankTwoCrossCoefficient lower upper a f b g =
      weightedCrossIncrement lower upper (fun k ↦ a k * b k) f g := by
  unfold affineRankTwoCrossCoefficient weightedCrossIncrement
  simp_rw [affineRankTwoMatchedCoordinate_eq]

/-- Within-block coefficient for arbitrary scalar rows of two rank-two
factors. -/
noncomputable def rankTwoWithinCoefficient
    (s : Finset ι)
    (leftZero leftOne rightZero rightOne : ι → ℝ) : ℝ :=
  (∑ k ∈ s, leftZero k * rightZero k) *
      (∑ k ∈ s, leftOne k * rightOne k) -
    (∑ k ∈ s, leftZero k * rightOne k) *
      (∑ k ∈ s, leftOne k * rightZero k)

/-- Cross-block coefficient for arbitrary scalar rows of two rank-two
factors. -/
noncomputable def rankTwoCrossCoefficient
    (lower upper : Finset ι)
    (leftZero leftOne rightZero rightOne : ι → ℝ) : ℝ :=
  (∑ k ∈ lower, leftZero k * rightZero k) *
      (∑ k ∈ upper, leftOne k * rightOne k) +
    (∑ k ∈ upper, leftZero k * rightZero k) *
      (∑ k ∈ lower, leftOne k * rightOne k) -
    (∑ k ∈ lower, leftZero k * rightOne k) *
      (∑ k ∈ upper, leftOne k * rightZero k) -
    (∑ k ∈ upper, leftZero k * rightOne k) *
      (∑ k ∈ lower, leftOne k * rightZero k)

/-- Sum of feature-indexed rank-one outer products, displayed as a `2 x 2`
matrix through its four scalar rows. -/
noncomputable def rankTwoBlockMatrix
    (s : Finset ι)
    (leftZero leftOne rightZero rightOne : ι → ℝ) :
    Matrix (Fin 2) (Fin 2) ℝ :=
  ![
    ![∑ k ∈ s, leftZero k * rightZero k,
      ∑ k ∈ s, leftZero k * rightOne k],
    ![∑ k ∈ s, leftOne k * rightZero k,
      ∑ k ∈ s, leftOne k * rightOne k]
  ]

/-- Rank-two Cauchy--Binet in scalar-row form. -/
theorem rankTwoBlockMatrix_det
    (s : Finset ι)
    (leftZero leftOne rightZero rightOne : ι → ℝ) :
    (rankTwoBlockMatrix s leftZero leftOne rightZero rightOne).det =
      rankTwoWithinCoefficient s leftZero leftOne rightZero rightOne := by
  rw [Matrix.det_fin_two]
  unfold rankTwoBlockMatrix rankTwoWithinCoefficient
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one]

/-- The mixed determinant coefficient between two feature blocks is their
cross-block sum of matched rank-two coordinates. -/
theorem finTwoPencilMixed_rankTwoBlockMatrix
    (lower upper : Finset ι)
    (leftZero leftOne rightZero rightOne : ι → ℝ) :
    finTwoPencilMixed
        (rankTwoBlockMatrix lower leftZero leftOne rightZero rightOne)
        (rankTwoBlockMatrix upper leftZero leftOne rightZero rightOne) =
      rankTwoCrossCoefficient lower upper
        leftZero leftOne rightZero rightOne := by
  unfold finTwoPencilMixed rankTwoBlockMatrix rankTwoCrossCoefficient
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one]

theorem rankTwoWithinCoefficient_eq_affine
    (s : Finset ι)
    (leftZero leftOne rightZero rightOne f g : ι → ℝ)
    (left_factor : ∀ k, leftOne k = leftZero k * f k)
    (right_factor : ∀ k, rightOne k = rightZero k * g k) :
    rankTwoWithinCoefficient s leftZero leftOne rightZero rightOne =
      affineRankTwoWithinCoefficient s leftZero f rightZero g := by
  rw [affineRankTwoWithinCoefficient_eq_weightedCovarianceNumerator]
  unfold rankTwoWithinCoefficient weightedCovarianceNumerator weightedMass
    weightedMoment
  simp_rw [left_factor, right_factor]
  have sum_f (t : Finset ι) :
      (∑ k ∈ t, leftZero k * f k * rightZero k) =
        ∑ k ∈ t, leftZero k * rightZero k * f k := by
    apply sum_congr rfl
    intro k hk
    ring
  have sum_fg (t : Finset ι) :
      (∑ k ∈ t, leftZero k * f k * (rightZero k * g k)) =
        ∑ k ∈ t, leftZero k * rightZero k * f k * g k := by
    apply sum_congr rfl
    intro k hk
    ring
  have sum_g (t : Finset ι) :
      (∑ k ∈ t, leftZero k * (rightZero k * g k)) =
        ∑ k ∈ t, leftZero k * rightZero k * g k := by
    apply sum_congr rfl
    intro k hk
    ring
  rw [sum_f, sum_fg, sum_g]
  ring

theorem rankTwoCrossCoefficient_eq_affine
    (lower upper : Finset ι)
    (leftZero leftOne rightZero rightOne f g : ι → ℝ)
    (left_factor : ∀ k, leftOne k = leftZero k * f k)
    (right_factor : ∀ k, rightOne k = rightZero k * g k) :
    rankTwoCrossCoefficient lower upper
        leftZero leftOne rightZero rightOne =
      affineRankTwoCrossCoefficient lower upper leftZero f rightZero g := by
  rw [affineRankTwoCrossCoefficient_eq_weightedCrossIncrement,
    weightedCrossIncrement_eq]
  unfold rankTwoCrossCoefficient weightedMass weightedMoment
  simp_rw [left_factor, right_factor]
  have sum_f (t : Finset ι) :
      (∑ k ∈ t, leftZero k * f k * rightZero k) =
        ∑ k ∈ t, leftZero k * rightZero k * f k := by
    apply sum_congr rfl
    intro k hk
    ring
  have sum_fg (t : Finset ι) :
      (∑ k ∈ t, leftZero k * f k * (rightZero k * g k)) =
        ∑ k ∈ t, leftZero k * rightZero k * f k * g k := by
    apply sum_congr rfl
    intro k hk
    ring
  have sum_g (t : Finset ι) :
      (∑ k ∈ t, leftZero k * (rightZero k * g k)) =
        ∑ k ∈ t, leftZero k * rightZero k * g k := by
    apply sum_congr rfl
    intro k hk
    ring
  rw [sum_f lower, sum_f upper, sum_fg lower, sum_fg upper,
    sum_g lower, sum_g upper]
  ring

variable [DecidableEq ι]

/-- The homogeneous basis change that places `pole` at infinity and swaps the
remaining affine coordinate into ratio position. -/
noncomputable def finTwoPoleBasis (pole : ℝ) : Matrix (Fin 2) (Fin 2) ℝ :=
  ![![-pole, 1], ![1, 0]]

/-- A pole basis with an independent orientation on the reciprocal
coordinate.  The case `orientation = 1` is `finTwoPoleBasis`. -/
noncomputable def finTwoOrientedPoleBasis
    (pole orientation : ℝ) : Matrix (Fin 2) (Fin 2) ℝ :=
  ![![-pole, 1], ![orientation, 0]]

/-- Scaling both coordinates changes the affine base sign without changing
the oriented reciprocal ratio. -/
noncomputable def finTwoScaledOrientedPoleBasis
    (pole orientation scale : ℝ) : Matrix (Fin 2) (Fin 2) ℝ :=
  scale • finTwoOrientedPoleBasis pole orientation

theorem finTwoPoleBasis_det (pole : ℝ) :
    (finTwoPoleBasis pole).det = -1 := by
  rw [Matrix.det_fin_two]
  norm_num [finTwoPoleBasis]

theorem finTwoOrientedPoleBasis_det (pole orientation : ℝ) :
    (finTwoOrientedPoleBasis pole orientation).det = -orientation := by
  rw [Matrix.det_fin_two]
  norm_num [finTwoOrientedPoleBasis]

theorem finTwoScaledOrientedPoleBasis_det
    (pole orientation scale : ℝ) :
    (finTwoScaledOrientedPoleBasis pole orientation scale).det =
      -(scale ^ 2 * orientation) := by
  rw [finTwoScaledOrientedPoleBasis, Matrix.det_smul,
    finTwoOrientedPoleBasis_det]
  norm_num

/-- Base coordinate after moving `pole` to projective infinity. -/
noncomputable def poleChartBase
    (base ratio : ι → ℝ) (pole : ℝ) (k : ι) : ℝ :=
  base k * ratio k - pole * base k

/-- Affine ratio in the pole chart. -/
noncomputable def poleChartRatio
    (ratio : ι → ℝ) (pole : ℝ) (k : ι) : ℝ :=
  (ratio k - pole)⁻¹

/-- Reciprocal pole-chart ratio with a chosen projective orientation. -/
noncomputable def orientedPoleChartRatio
    (ratio : ι → ℝ) (pole orientation : ℝ) (k : ι) : ℝ :=
  orientation * (ratio k - pole)⁻¹

/-- Base coordinate in a pole chart after a common nonzero chart scaling. -/
noncomputable def scaledPoleChartBase
    (base ratio : ι → ℝ) (pole scale : ℝ) (k : ι) : ℝ :=
  scale * poleChartBase base ratio pole k

omit [DecidableEq ι] in
/-- Exact two-sided action of the two pole bases on a feature block. -/
theorem finTwoPoleBasis_mul_rankTwoBlockMatrix_mul
    (s : Finset ι)
    (leftZero leftOne rightZero rightOne : ι → ℝ)
    (leftPole rightPole : ℝ) :
    finTwoPoleBasis leftPole *
          rankTwoBlockMatrix s leftZero leftOne rightZero rightOne *
        finTwoPoleBasis rightPole =
      rankTwoBlockMatrix s
        (fun k ↦ leftOne k - leftPole * leftZero k) leftZero
        (fun k ↦ rightOne k - rightPole * rightZero k) rightZero := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp only [Matrix.mul_apply, Fin.sum_univ_two]
  all_goals
    simp [finTwoPoleBasis, rankTwoBlockMatrix]
    try simp_rw [mul_sub, sub_mul]
    try simp only [sum_sub_distrib, sum_mul, mul_sum]
  all_goals ring_nf
  all_goals
    simp only [sum_add_distrib, sum_neg_distrib, sum_mul]
    try ring_nf
  have product_sum_comm :
      (∑ k ∈ s,
        leftPole * leftZero k * rightZero k * rightPole) =
      ∑ k ∈ s,
        leftPole * rightPole * leftZero k * rightZero k := by
    apply sum_congr rfl
    intro k hk
    ring
  rw [product_sum_comm]
  ring

omit [DecidableEq ι] in
/-- Exact two-sided feature-block action when the left pole chart also chooses
an orientation for its reciprocal coordinate. -/
theorem finTwoOrientedPoleBasis_mul_rankTwoBlockMatrix_mul
    (s : Finset ι)
    (leftZero leftOne rightZero rightOne : ι → ℝ)
    (leftPole rightPole orientation : ℝ) :
    finTwoOrientedPoleBasis leftPole orientation *
          rankTwoBlockMatrix s leftZero leftOne rightZero rightOne *
        finTwoPoleBasis rightPole =
      rankTwoBlockMatrix s
        (fun k ↦ leftOne k - leftPole * leftZero k)
        (fun k ↦ orientation * leftZero k)
        (fun k ↦ rightOne k - rightPole * rightZero k) rightZero := by
  let orient : Matrix (Fin 2) (Fin 2) ℝ :=
    ![![1, 0], ![0, orientation]]
  have basis_eq :
      finTwoOrientedPoleBasis leftPole orientation =
        orient * finTwoPoleBasis leftPole := by
    ext i j
    fin_cases i <;> fin_cases j
    all_goals rw [Matrix.mul_apply]
    all_goals norm_num [orient, finTwoOrientedPoleBasis, finTwoPoleBasis,
      Fin.sum_univ_two]
  rw [basis_eq]
  calc
    (orient * finTwoPoleBasis leftPole) *
          rankTwoBlockMatrix s leftZero leftOne rightZero rightOne *
        finTwoPoleBasis rightPole =
        orient * (finTwoPoleBasis leftPole *
          rankTwoBlockMatrix s leftZero leftOne rightZero rightOne *
            finTwoPoleBasis rightPole) := by
      simp only [Matrix.mul_assoc]
    _ = orient * rankTwoBlockMatrix s
        (fun k ↦ leftOne k - leftPole * leftZero k) leftZero
        (fun k ↦ rightOne k - rightPole * rightZero k) rightZero := by
      rw [finTwoPoleBasis_mul_rankTwoBlockMatrix_mul]
    _ = _ := by
      ext i j
      fin_cases i <;> fin_cases j
      all_goals rw [Matrix.mul_apply]
      all_goals simp [orient, rankTwoBlockMatrix, Fin.sum_univ_two, mul_sum]
      all_goals
        apply sum_congr rfl
        intro k hk
        ring

omit [DecidableEq ι] in
/-- The scaled oriented pole basis multiplies both transformed left scalar
rows by the common chart scale. -/
theorem finTwoScaledOrientedPoleBasis_mul_rankTwoBlockMatrix_mul
    (s : Finset ι)
    (leftZero leftOne rightZero rightOne : ι → ℝ)
    (leftPole rightPole orientation scale : ℝ) :
    finTwoScaledOrientedPoleBasis leftPole orientation scale *
          rankTwoBlockMatrix s leftZero leftOne rightZero rightOne *
        finTwoPoleBasis rightPole =
      rankTwoBlockMatrix s
        (fun k ↦ scale * (leftOne k - leftPole * leftZero k))
        (fun k ↦ scale * orientation * leftZero k)
        (fun k ↦ rightOne k - rightPole * rightZero k) rightZero := by
  rw [finTwoScaledOrientedPoleBasis, Matrix.smul_mul,
    Matrix.smul_mul,
    finTwoOrientedPoleBasis_mul_rankTwoBlockMatrix_mul]
  ext i j
  fin_cases i <;> fin_cases j
  all_goals rw [Matrix.smul_apply]
  all_goals simp [rankTwoBlockMatrix, mul_sum]
  all_goals
    apply sum_congr rfl
    intro k hk
    ring

omit [DecidableEq ι] in
theorem poleChartBase_mul_orientedPoleChartRatio
    (base ratio : ι → ℝ) (pole orientation : ℝ)
    (pole_ne : ∀ k, ratio k ≠ pole) (k : ι) :
    orientation * base k =
      poleChartBase base ratio pole k *
        orientedPoleChartRatio ratio pole orientation k := by
  unfold poleChartBase orientedPoleChartRatio
  have difference_ne : ratio k - pole ≠ 0 := sub_ne_zero.mpr (pole_ne k)
  field_simp

omit [DecidableEq ι] in
theorem scaledPoleChartBase_mul_orientedPoleChartRatio
    (base ratio : ι → ℝ) (pole orientation scale : ℝ)
    (pole_ne : ∀ k, ratio k ≠ pole) (k : ι) :
    scale * orientation * base k =
      scaledPoleChartBase base ratio pole scale k *
        orientedPoleChartRatio ratio pole orientation k := by
  unfold scaledPoleChartBase
  calc
    scale * orientation * base k =
        scale * (orientation * base k) := by ring
    _ = scale * (poleChartBase base ratio pole k *
        orientedPoleChartRatio ratio pole orientation k) := by
      rw [poleChartBase_mul_orientedPoleChartRatio
        base ratio pole orientation pole_ne]
    _ = _ := by ring

omit [DecidableEq ι] in
theorem poleChartBase_mul_poleChartRatio
    (base ratio : ι → ℝ) (pole : ℝ)
    (pole_ne : ∀ k, ratio k ≠ pole) (k : ι) :
    base k = poleChartBase base ratio pole k * poleChartRatio ratio pole k := by
  unfold poleChartBase poleChartRatio
  have difference_ne : ratio k - pole ≠ 0 := sub_ne_zero.mpr (pole_ne k)
  field_simp

omit [DecidableEq ι] in
/-- A matched rank-two coordinate is unchanged by independent pole charts on
the two homogeneous factors.  Each pole basis has determinant `-1`, so the
two orientation changes cancel. -/
theorem affineRankTwoMatchedCoordinate_poleChart
    (a f b g : ι → ℝ) (leftPole rightPole : ℝ)
    (left_pole_ne : ∀ k, f k ≠ leftPole)
    (right_pole_ne : ∀ k, g k ≠ rightPole) (i j : ι) :
    affineRankTwoMatchedCoordinate
        (poleChartBase a f leftPole) (poleChartRatio f leftPole)
        (poleChartBase b g rightPole) (poleChartRatio g rightPole) i j =
      affineRankTwoMatchedCoordinate a f b g i j := by
  rw [affineRankTwoMatchedCoordinate_eq,
    affineRankTwoMatchedCoordinate_eq]
  unfold poleChartBase poleChartRatio
  have left_i_ne : f i - leftPole ≠ 0 :=
    sub_ne_zero.mpr (left_pole_ne i)
  have left_j_ne : f j - leftPole ≠ 0 :=
    sub_ne_zero.mpr (left_pole_ne j)
  have right_i_ne : g i - rightPole ≠ 0 :=
    sub_ne_zero.mpr (right_pole_ne i)
  have right_j_ne : g j - rightPole ≠ 0 :=
    sub_ne_zero.mpr (right_pole_ne j)
  field_simp
  ring

omit [DecidableEq ι] in
/-- An oriented left pole chart scales every matched coordinate by its
orientation.  This is the determinant product of the two basis changes. -/
theorem affineRankTwoMatchedCoordinate_orientedPoleChart
    (a f b g : ι → ℝ) (leftPole rightPole orientation : ℝ)
    (left_pole_ne : ∀ k, f k ≠ leftPole)
    (right_pole_ne : ∀ k, g k ≠ rightPole) (i j : ι) :
    affineRankTwoMatchedCoordinate
        (poleChartBase a f leftPole)
        (orientedPoleChartRatio f leftPole orientation)
        (poleChartBase b g rightPole) (poleChartRatio g rightPole) i j =
      orientation * affineRankTwoMatchedCoordinate a f b g i j := by
  rw [affineRankTwoMatchedCoordinate_eq,
    affineRankTwoMatchedCoordinate_eq]
  unfold poleChartBase orientedPoleChartRatio poleChartRatio
  have left_i_ne : f i - leftPole ≠ 0 :=
    sub_ne_zero.mpr (left_pole_ne i)
  have left_j_ne : f j - leftPole ≠ 0 :=
    sub_ne_zero.mpr (left_pole_ne j)
  have right_i_ne : g i - rightPole ≠ 0 :=
    sub_ne_zero.mpr (right_pole_ne i)
  have right_j_ne : g j - rightPole ≠ 0 :=
    sub_ne_zero.mpr (right_pole_ne j)
  field_simp
  ring

omit [DecidableEq ι] in
/-- A common chart scale contributes its square to every matched coordinate
and therefore does not change the projective orientation sign. -/
theorem affineRankTwoMatchedCoordinate_scaledOrientedPoleChart
    (a f b g : ι → ℝ) (leftPole rightPole orientation scale : ℝ)
    (left_pole_ne : ∀ k, f k ≠ leftPole)
    (right_pole_ne : ∀ k, g k ≠ rightPole) (i j : ι) :
    affineRankTwoMatchedCoordinate
        (scaledPoleChartBase a f leftPole scale)
        (orientedPoleChartRatio f leftPole orientation)
        (poleChartBase b g rightPole) (poleChartRatio g rightPole) i j =
      scale ^ 2 * orientation *
        affineRankTwoMatchedCoordinate a f b g i j := by
  rw [affineRankTwoMatchedCoordinate_eq,
    affineRankTwoMatchedCoordinate_eq]
  unfold scaledPoleChartBase poleChartBase orientedPoleChartRatio poleChartRatio
  have left_i_ne : f i - leftPole ≠ 0 :=
    sub_ne_zero.mpr (left_pole_ne i)
  have left_j_ne : f j - leftPole ≠ 0 :=
    sub_ne_zero.mpr (left_pole_ne j)
  have right_i_ne : g i - rightPole ≠ 0 :=
    sub_ne_zero.mpr (right_pole_ne i)
  have right_j_ne : g j - rightPole ≠ 0 :=
    sub_ne_zero.mpr (right_pole_ne j)
  field_simp
  ring

omit [DecidableEq ι] in
/-- Positive singleton weights in a pole chart turn nonnegative projective
matched coordinates into comonotonicity of the two reciprocal ratios. -/
theorem poleChartRatio_monovaryOn_of_matched_nonneg
    (s : Finset ι) (a f b g : ι → ℝ) (leftPole rightPole : ℝ)
    (left_pole_ne : ∀ k, f k ≠ leftPole)
    (right_pole_ne : ∀ k, g k ≠ rightPole)
    (weight_pos : ∀ k ∈ s,
      0 < poleChartBase a f leftPole k * poleChartBase b g rightPole k)
    (matched_nonneg : ∀ i ∈ s, ∀ j ∈ s,
      0 ≤ affineRankTwoMatchedCoordinate a f b g i j) :
    MonovaryOn (poleChartRatio f leftPole)
      (poleChartRatio g rightPole) s := by
  intro i hi j hj right_lt
  have coordinate_nonneg := matched_nonneg i hi j hj
  rw [← affineRankTwoMatchedCoordinate_poleChart a f b g
    leftPole rightPole left_pole_ne right_pole_ne i j,
    affineRankTwoMatchedCoordinate_eq] at coordinate_nonneg
  have weights_pos :
      0 < (poleChartBase a f leftPole i * poleChartBase b g rightPole i) *
        (poleChartBase a f leftPole j * poleChartBase b g rightPole j) :=
    mul_pos (weight_pos i hi) (weight_pos j hj)
  have right_difference_pos :
      0 < poleChartRatio g rightPole j - poleChartRatio g rightPole i :=
    sub_pos.mpr right_lt
  have coefficient_pos :
      0 < (poleChartBase a f leftPole i * poleChartBase b g rightPole i) *
          (poleChartBase a f leftPole j * poleChartBase b g rightPole j) *
        (poleChartRatio g rightPole j - poleChartRatio g rightPole i) :=
    mul_pos weights_pos right_difference_pos
  have reordered :
      0 ≤ ((poleChartBase a f leftPole i * poleChartBase b g rightPole i) *
            (poleChartBase a f leftPole j * poleChartBase b g rightPole j) *
          (poleChartRatio g rightPole j - poleChartRatio g rightPole i)) *
        (poleChartRatio f leftPole j - poleChartRatio f leftPole i) := by
    convert coordinate_nonneg using 1
    all_goals ring
  exact sub_nonneg.mp (nonneg_of_mul_nonneg_right reordered coefficient_pos)

omit [DecidableEq ι] in
/-- Oriented version of the projective matched-minor criterion. -/
theorem orientedPoleChartRatio_monovaryOn_of_matched_nonneg
    (s : Finset ι) (a f b g : ι → ℝ)
    (leftPole rightPole orientation : ℝ)
    (left_pole_ne : ∀ k, f k ≠ leftPole)
    (right_pole_ne : ∀ k, g k ≠ rightPole)
    (weight_pos : ∀ k ∈ s,
      0 < poleChartBase a f leftPole k * poleChartBase b g rightPole k)
    (matched_nonneg : ∀ i ∈ s, ∀ j ∈ s,
      0 ≤ orientation * affineRankTwoMatchedCoordinate a f b g i j) :
    MonovaryOn (orientedPoleChartRatio f leftPole orientation)
      (poleChartRatio g rightPole) s := by
  intro i hi j hj right_lt
  have coordinate_nonneg := matched_nonneg i hi j hj
  rw [← affineRankTwoMatchedCoordinate_orientedPoleChart a f b g
    leftPole rightPole orientation left_pole_ne right_pole_ne i j,
    affineRankTwoMatchedCoordinate_eq] at coordinate_nonneg
  have weights_pos :
      0 < (poleChartBase a f leftPole i * poleChartBase b g rightPole i) *
        (poleChartBase a f leftPole j * poleChartBase b g rightPole j) :=
    mul_pos (weight_pos i hi) (weight_pos j hj)
  have right_difference_pos :
      0 < poleChartRatio g rightPole j - poleChartRatio g rightPole i :=
    sub_pos.mpr right_lt
  have coefficient_pos :
      0 < (poleChartBase a f leftPole i * poleChartBase b g rightPole i) *
          (poleChartBase a f leftPole j * poleChartBase b g rightPole j) *
        (poleChartRatio g rightPole j - poleChartRatio g rightPole i) :=
    mul_pos weights_pos right_difference_pos
  have reordered :
      0 ≤ ((poleChartBase a f leftPole i * poleChartBase b g rightPole i) *
            (poleChartBase a f leftPole j * poleChartBase b g rightPole j) *
          (poleChartRatio g rightPole j - poleChartRatio g rightPole i)) *
        (orientedPoleChartRatio f leftPole orientation j -
          orientedPoleChartRatio f leftPole orientation i) := by
    convert coordinate_nonneg using 1
    all_goals ring
  exact sub_nonneg.mp (nonneg_of_mul_nonneg_right reordered coefficient_pos)

omit [DecidableEq ι] in
/-- Projective matched-minor criterion with an independent common chart scale
used to choose the sign of every transformed singleton weight. -/
theorem scaledOrientedPoleChartRatio_monovaryOn_of_matched_nonneg
    (s : Finset ι) (a f b g : ι → ℝ)
    (leftPole rightPole orientation scale : ℝ)
    (left_pole_ne : ∀ k, f k ≠ leftPole)
    (right_pole_ne : ∀ k, g k ≠ rightPole)
    (weight_pos : ∀ k ∈ s,
      0 < scaledPoleChartBase a f leftPole scale k *
        poleChartBase b g rightPole k)
    (matched_nonneg : ∀ i ∈ s, ∀ j ∈ s,
      0 ≤ orientation * affineRankTwoMatchedCoordinate a f b g i j) :
    MonovaryOn (orientedPoleChartRatio f leftPole orientation)
      (poleChartRatio g rightPole) s := by
  intro i hi j hj right_lt
  have coordinate_nonneg :
      0 ≤ affineRankTwoMatchedCoordinate
        (scaledPoleChartBase a f leftPole scale)
        (orientedPoleChartRatio f leftPole orientation)
        (poleChartBase b g rightPole) (poleChartRatio g rightPole) i j := by
    rw [affineRankTwoMatchedCoordinate_scaledOrientedPoleChart a f b g
      leftPole rightPole orientation scale left_pole_ne right_pole_ne]
    simpa only [mul_assoc] using
      mul_nonneg (sq_nonneg scale) (matched_nonneg i hi j hj)
  rw [affineRankTwoMatchedCoordinate_eq] at coordinate_nonneg
  have weights_pos :
      0 < (scaledPoleChartBase a f leftPole scale i *
            poleChartBase b g rightPole i) *
        (scaledPoleChartBase a f leftPole scale j *
            poleChartBase b g rightPole j) :=
    mul_pos (weight_pos i hi) (weight_pos j hj)
  have right_difference_pos :
      0 < poleChartRatio g rightPole j - poleChartRatio g rightPole i :=
    sub_pos.mpr right_lt
  have coefficient_pos :
      0 < (scaledPoleChartBase a f leftPole scale i *
            poleChartBase b g rightPole i) *
          (scaledPoleChartBase a f leftPole scale j *
            poleChartBase b g rightPole j) *
        (poleChartRatio g rightPole j - poleChartRatio g rightPole i) :=
    mul_pos weights_pos right_difference_pos
  have reordered :
      0 ≤ ((scaledPoleChartBase a f leftPole scale i *
              poleChartBase b g rightPole i) *
            (scaledPoleChartBase a f leftPole scale j *
              poleChartBase b g rightPole j) *
          (poleChartRatio g rightPole j - poleChartRatio g rightPole i)) *
        (orientedPoleChartRatio f leftPole orientation j -
          orientedPoleChartRatio f leftPole orientation i) := by
    convert coordinate_nonneg using 1
    all_goals ring
  exact sub_nonneg.mp (nonneg_of_mul_nonneg_right reordered coefficient_pos)

/-- A positive ordered affine chart for two rank-two factors gives the sharp
Lorentzian inequality for every threshold split.  The theorem contains no
division: a later projective argument only needs to supply the four chart
coordinates and their sign/order certificates. -/
theorem affineRankTwoCoefficients_lorentzian
    (lower upper : Finset ι) (a f b g : ι → ℝ)
    (lower_mass_pos : 0 < weightedMass lower (fun k ↦ a k * b k))
    (upper_mass_pos : 0 < weightedMass upper (fun k ↦ a k * b k))
    (weight_nonneg : ∀ k ∈ lower ∪ upper, 0 ≤ a k * b k)
    (lower_monovary : MonovaryOn f g lower)
    (upper_monovary : MonovaryOn f g upper)
    (f_cross : ∀ i ∈ lower, ∀ j ∈ upper, f i ≤ f j)
    (g_cross : ∀ i ∈ lower, ∀ j ∈ upper, g i ≤ g j) :
    4 * affineRankTwoWithinCoefficient lower a f b g *
        affineRankTwoWithinCoefficient upper a f b g ≤
      affineRankTwoCrossCoefficient lower upper a f b g ^ 2 := by
  rw [affineRankTwoWithinCoefficient_eq_weightedCovarianceNumerator,
    affineRankTwoWithinCoefficient_eq_weightedCovarianceNumerator,
    affineRankTwoCrossCoefficient_eq_weightedCrossIncrement]
  exact four_mul_weightedCovarianceNumerator_mul_le_crossIncrement_sq
    lower upper (fun k ↦ a k * b k) f g lower_mass_pos upper_mass_pos
    weight_nonneg lower_monovary upper_monovary f_cross g_cross

/-- Certificate-oriented form for arbitrary left/right scalar rows.  A
projective chart supplies only the two factorization equalities and the
positivity/order hypotheses; the resulting coefficient inequality is stated
for the original, unnormalized rank-two coordinates. -/
theorem rankTwoCoefficients_lorentzian_of_affine
    (lower upper : Finset ι)
    (leftZero leftOne rightZero rightOne f g : ι → ℝ)
    (left_factor : ∀ k, leftOne k = leftZero k * f k)
    (right_factor : ∀ k, rightOne k = rightZero k * g k)
    (lower_mass_pos :
      0 < weightedMass lower (fun k ↦ leftZero k * rightZero k))
    (upper_mass_pos :
      0 < weightedMass upper (fun k ↦ leftZero k * rightZero k))
    (weight_nonneg :
      ∀ k ∈ lower ∪ upper, 0 ≤ leftZero k * rightZero k)
    (lower_monovary : MonovaryOn f g lower)
    (upper_monovary : MonovaryOn f g upper)
    (f_cross : ∀ i ∈ lower, ∀ j ∈ upper, f i ≤ f j)
    (g_cross : ∀ i ∈ lower, ∀ j ∈ upper, g i ≤ g j) :
    4 * rankTwoWithinCoefficient lower
          leftZero leftOne rightZero rightOne *
        rankTwoWithinCoefficient upper
          leftZero leftOne rightZero rightOne ≤
      rankTwoCrossCoefficient lower upper
          leftZero leftOne rightZero rightOne ^ 2 := by
  rw [rankTwoWithinCoefficient_eq_affine _ _ _ _ _ _ _
      left_factor right_factor,
    rankTwoWithinCoefficient_eq_affine _ _ _ _ _ _ _
      left_factor right_factor,
    rankTwoCrossCoefficient_eq_affine _ _ _ _ _ _ _ _
      left_factor right_factor]
  exact affineRankTwoCoefficients_lorentzian lower upper leftZero f rightZero g
    lower_mass_pos upper_mass_pos weight_nonneg lower_monovary upper_monovary
    f_cross g_cross

/-- Matrix-pencil form of the projective ratio certificate.  This is the
direct interface to the fresh-order-two quadratic factorization theorem. -/
theorem rankTwoBlockPencil_lorentzian_of_affine
    (lower upper : Finset ι)
    (leftZero leftOne rightZero rightOne f g : ι → ℝ)
    (left_factor : ∀ k, leftOne k = leftZero k * f k)
    (right_factor : ∀ k, rightOne k = rightZero k * g k)
    (lower_mass_pos :
      0 < weightedMass lower (fun k ↦ leftZero k * rightZero k))
    (upper_mass_pos :
      0 < weightedMass upper (fun k ↦ leftZero k * rightZero k))
    (weight_nonneg :
      ∀ k ∈ lower ∪ upper, 0 ≤ leftZero k * rightZero k)
    (lower_monovary : MonovaryOn f g lower)
    (upper_monovary : MonovaryOn f g upper)
    (f_cross : ∀ i ∈ lower, ∀ j ∈ upper, f i ≤ f j)
    (g_cross : ∀ i ∈ lower, ∀ j ∈ upper, g i ≤ g j) :
    4 * (rankTwoBlockMatrix lower
          leftZero leftOne rightZero rightOne).det *
        (rankTwoBlockMatrix upper
          leftZero leftOne rightZero rightOne).det ≤
      finTwoPencilMixed
          (rankTwoBlockMatrix lower
            leftZero leftOne rightZero rightOne)
          (rankTwoBlockMatrix upper
            leftZero leftOne rightZero rightOne) ^ 2 := by
  rw [rankTwoBlockMatrix_det, rankTwoBlockMatrix_det,
    finTwoPencilMixed_rankTwoBlockMatrix]
  exact rankTwoCoefficients_lorentzian_of_affine lower upper
    leftZero leftOne rightZero rightOne f g left_factor right_factor
    lower_mass_pos upper_mass_pos weight_nonneg lower_monovary upper_monovary
    f_cross g_cross

/-- A cutoff-specific projective chart may be used to certify the original
rank-two pencil.  Invertibility transfers the chart inequality back through
the two-sided basis change. -/
theorem rankTwoBlockPencil_lorentzian_of_projective_affine
    (leftBasis rightBasis low high : Matrix (Fin 2) (Fin 2) ℝ)
    (lower upper : Finset ι)
    (leftZero leftOne rightZero rightOne f g : ι → ℝ)
    (left_det_ne : leftBasis.det ≠ 0)
    (right_det_ne : rightBasis.det ≠ 0)
    (low_chart : leftBasis * low * rightBasis =
      rankTwoBlockMatrix lower leftZero leftOne rightZero rightOne)
    (high_chart : leftBasis * high * rightBasis =
      rankTwoBlockMatrix upper leftZero leftOne rightZero rightOne)
    (left_factor : ∀ k, leftOne k = leftZero k * f k)
    (right_factor : ∀ k, rightOne k = rightZero k * g k)
    (lower_mass_pos :
      0 < weightedMass lower (fun k ↦ leftZero k * rightZero k))
    (upper_mass_pos :
      0 < weightedMass upper (fun k ↦ leftZero k * rightZero k))
    (weight_nonneg :
      ∀ k ∈ lower ∪ upper, 0 ≤ leftZero k * rightZero k)
    (lower_monovary : MonovaryOn f g lower)
    (upper_monovary : MonovaryOn f g upper)
    (f_cross : ∀ i ∈ lower, ∀ j ∈ upper, f i ≤ f j)
    (g_cross : ∀ i ∈ lower, ∀ j ∈ upper, g i ≤ g j) :
    4 * low.det * high.det ≤ finTwoPencilMixed low high ^ 2 := by
  have chart_lorentzian := rankTwoBlockPencil_lorentzian_of_affine
    lower upper leftZero leftOne rightZero rightOne f g
    left_factor right_factor lower_mass_pos upper_mass_pos weight_nonneg
    lower_monovary upper_monovary f_cross g_cross
  have transformed_lorentzian :
      4 * (leftBasis * low * rightBasis).det *
          (leftBasis * high * rightBasis).det ≤
        finTwoPencilMixed (leftBasis * low * rightBasis)
          (leftBasis * high * rightBasis) ^ 2 := by
    rw [low_chart, high_chart]
    exact chart_lorentzian
  exact (finTwoPencil_lorentzian_mul_mul_iff
    leftBasis low high rightBasis left_det_ne right_det_ne).mp
      transformed_lorentzian

/-- Explicit separating-pole certificate for an original affine rank-two
pencil.  The analytic caller supplies positivity and ordering only after the
two poles have unwrapped the projective degree blocks. -/
theorem rankTwoBlockPencil_lorentzian_of_poles
    (lower upper : Finset ι) (a f b g : ι → ℝ)
    (leftPole rightPole : ℝ)
    (left_pole_ne : ∀ k, f k ≠ leftPole)
    (right_pole_ne : ∀ k, g k ≠ rightPole)
    (lower_mass_pos : 0 < weightedMass lower (fun k ↦
      poleChartBase a f leftPole k * poleChartBase b g rightPole k))
    (upper_mass_pos : 0 < weightedMass upper (fun k ↦
      poleChartBase a f leftPole k * poleChartBase b g rightPole k))
    (weight_nonneg : ∀ k ∈ lower ∪ upper,
      0 ≤ poleChartBase a f leftPole k * poleChartBase b g rightPole k)
    (lower_monovary :
      MonovaryOn (poleChartRatio f leftPole)
        (poleChartRatio g rightPole) lower)
    (upper_monovary :
      MonovaryOn (poleChartRatio f leftPole)
        (poleChartRatio g rightPole) upper)
    (f_cross : ∀ i ∈ lower, ∀ j ∈ upper,
      poleChartRatio f leftPole i ≤ poleChartRatio f leftPole j)
    (g_cross : ∀ i ∈ lower, ∀ j ∈ upper,
      poleChartRatio g rightPole i ≤ poleChartRatio g rightPole j) :
    4 * (rankTwoBlockMatrix lower a (fun k ↦ a k * f k)
          b (fun k ↦ b k * g k)).det *
        (rankTwoBlockMatrix upper a (fun k ↦ a k * f k)
          b (fun k ↦ b k * g k)).det ≤
      finTwoPencilMixed
          (rankTwoBlockMatrix lower a (fun k ↦ a k * f k)
            b (fun k ↦ b k * g k))
          (rankTwoBlockMatrix upper a (fun k ↦ a k * f k)
            b (fun k ↦ b k * g k)) ^ 2 := by
  apply rankTwoBlockPencil_lorentzian_of_projective_affine
    (finTwoPoleBasis leftPole) (finTwoPoleBasis rightPole)
    (rankTwoBlockMatrix lower a (fun k ↦ a k * f k)
      b (fun k ↦ b k * g k))
    (rankTwoBlockMatrix upper a (fun k ↦ a k * f k)
      b (fun k ↦ b k * g k))
    lower upper
    (poleChartBase a f leftPole) a
    (poleChartBase b g rightPole) b
    (poleChartRatio f leftPole) (poleChartRatio g rightPole)
  · rw [finTwoPoleBasis_det]
    norm_num
  · rw [finTwoPoleBasis_det]
    norm_num
  · have chart := finTwoPoleBasis_mul_rankTwoBlockMatrix_mul lower a
        (fun k ↦ a k * f k) b (fun k ↦ b k * g k)
        leftPole rightPole
    have left_base_eq :
        (fun k ↦ a k * f k - leftPole * a k) =
          poleChartBase a f leftPole := by rfl
    have right_base_eq :
        (fun k ↦ b k * g k - rightPole * b k) =
          poleChartBase b g rightPole := by rfl
    change _ = rankTwoBlockMatrix lower
      (poleChartBase a f leftPole) a (poleChartBase b g rightPole) b
    rw [← left_base_eq, ← right_base_eq]
    exact chart
  · have chart := finTwoPoleBasis_mul_rankTwoBlockMatrix_mul upper a
        (fun k ↦ a k * f k) b (fun k ↦ b k * g k)
        leftPole rightPole
    have left_base_eq :
        (fun k ↦ a k * f k - leftPole * a k) =
          poleChartBase a f leftPole := by rfl
    have right_base_eq :
        (fun k ↦ b k * g k - rightPole * b k) =
          poleChartBase b g rightPole := by rfl
    change _ = rankTwoBlockMatrix upper
      (poleChartBase a f leftPole) a (poleChartBase b g rightPole) b
    rw [← left_base_eq, ← right_base_eq]
    exact chart
  · exact poleChartBase_mul_poleChartRatio a f leftPole left_pole_ne
  · exact poleChartBase_mul_poleChartRatio b g rightPole right_pole_ne
  · exact lower_mass_pos
  · exact upper_mass_pos
  · exact weight_nonneg
  · exact lower_monovary
  · exact upper_monovary
  · exact f_cross
  · exact g_cross

/-- Matched-minor form of the separating-pole certificate.  Positive pole-
chart singleton weights convert projective matched-coordinate signs into the
two within-block comonotonicity hypotheses, while nonempty blocks give the
positive masses.  Only cross ordering remains chart-specific. -/
theorem rankTwoBlockPencil_lorentzian_of_poles_of_matched_nonneg
    (lower upper : Finset ι) (a f b g : ι → ℝ)
    (leftPole rightPole : ℝ)
    (left_pole_ne : ∀ k, f k ≠ leftPole)
    (right_pole_ne : ∀ k, g k ≠ rightPole)
    (lower_nonempty : lower.Nonempty) (upper_nonempty : upper.Nonempty)
    (weight_pos : ∀ k ∈ lower ∪ upper,
      0 < poleChartBase a f leftPole k * poleChartBase b g rightPole k)
    (lower_matched_nonneg : ∀ i ∈ lower, ∀ j ∈ lower,
      0 ≤ affineRankTwoMatchedCoordinate a f b g i j)
    (upper_matched_nonneg : ∀ i ∈ upper, ∀ j ∈ upper,
      0 ≤ affineRankTwoMatchedCoordinate a f b g i j)
    (f_cross : ∀ i ∈ lower, ∀ j ∈ upper,
      poleChartRatio f leftPole i ≤ poleChartRatio f leftPole j)
    (g_cross : ∀ i ∈ lower, ∀ j ∈ upper,
      poleChartRatio g rightPole i ≤ poleChartRatio g rightPole j) :
    4 * (rankTwoBlockMatrix lower a (fun k ↦ a k * f k)
          b (fun k ↦ b k * g k)).det *
        (rankTwoBlockMatrix upper a (fun k ↦ a k * f k)
          b (fun k ↦ b k * g k)).det ≤
      finTwoPencilMixed
          (rankTwoBlockMatrix lower a (fun k ↦ a k * f k)
            b (fun k ↦ b k * g k))
          (rankTwoBlockMatrix upper a (fun k ↦ a k * f k)
            b (fun k ↦ b k * g k)) ^ 2 := by
  apply rankTwoBlockPencil_lorentzian_of_poles lower upper a f b g
    leftPole rightPole left_pole_ne right_pole_ne
  · unfold weightedMass
    apply sum_pos
    · intro k hk
      exact weight_pos k (mem_union_left upper hk)
    · exact lower_nonempty
  · unfold weightedMass
    apply sum_pos
    · intro k hk
      exact weight_pos k (mem_union_right lower hk)
    · exact upper_nonempty
  · intro k hk
    exact (weight_pos k hk).le
  · apply poleChartRatio_monovaryOn_of_matched_nonneg lower a f b g
      leftPole rightPole left_pole_ne right_pole_ne
    · intro k hk
      exact weight_pos k (mem_union_left upper hk)
    · exact lower_matched_nonneg
  · apply poleChartRatio_monovaryOn_of_matched_nonneg upper a f b g
      leftPole rightPole left_pole_ne right_pole_ne
    · intro k hk
      exact weight_pos k (mem_union_right lower hk)
    · exact upper_matched_nonneg
  · exact f_cross
  · exact g_cross

/-- Orientation-complete matched-minor separator theorem.  The nonzero scalar
`orientation` reverses the left projective circle when needed; Phase CO then
transfers the Lorentzian inequality through the resulting determinant scale. -/
theorem rankTwoBlockPencil_lorentzian_of_oriented_poles_of_matched_nonneg
    (lower upper : Finset ι) (a f b g : ι → ℝ)
    (leftPole rightPole orientation : ℝ)
    (orientation_ne : orientation ≠ 0)
    (left_pole_ne : ∀ k, f k ≠ leftPole)
    (right_pole_ne : ∀ k, g k ≠ rightPole)
    (lower_nonempty : lower.Nonempty) (upper_nonempty : upper.Nonempty)
    (weight_pos : ∀ k ∈ lower ∪ upper,
      0 < poleChartBase a f leftPole k * poleChartBase b g rightPole k)
    (lower_matched_nonneg : ∀ i ∈ lower, ∀ j ∈ lower,
      0 ≤ orientation * affineRankTwoMatchedCoordinate a f b g i j)
    (upper_matched_nonneg : ∀ i ∈ upper, ∀ j ∈ upper,
      0 ≤ orientation * affineRankTwoMatchedCoordinate a f b g i j)
    (f_cross : ∀ i ∈ lower, ∀ j ∈ upper,
      orientedPoleChartRatio f leftPole orientation i ≤
        orientedPoleChartRatio f leftPole orientation j)
    (g_cross : ∀ i ∈ lower, ∀ j ∈ upper,
      poleChartRatio g rightPole i ≤ poleChartRatio g rightPole j) :
    4 * (rankTwoBlockMatrix lower a (fun k ↦ a k * f k)
          b (fun k ↦ b k * g k)).det *
        (rankTwoBlockMatrix upper a (fun k ↦ a k * f k)
          b (fun k ↦ b k * g k)).det ≤
      finTwoPencilMixed
          (rankTwoBlockMatrix lower a (fun k ↦ a k * f k)
            b (fun k ↦ b k * g k))
          (rankTwoBlockMatrix upper a (fun k ↦ a k * f k)
            b (fun k ↦ b k * g k)) ^ 2 := by
  apply rankTwoBlockPencil_lorentzian_of_projective_affine
    (finTwoOrientedPoleBasis leftPole orientation)
    (finTwoPoleBasis rightPole)
    (rankTwoBlockMatrix lower a (fun k ↦ a k * f k)
      b (fun k ↦ b k * g k))
    (rankTwoBlockMatrix upper a (fun k ↦ a k * f k)
      b (fun k ↦ b k * g k))
    lower upper
    (poleChartBase a f leftPole) (fun k ↦ orientation * a k)
    (poleChartBase b g rightPole) b
    (orientedPoleChartRatio f leftPole orientation)
    (poleChartRatio g rightPole)
  · rw [finTwoOrientedPoleBasis_det]
    exact neg_ne_zero.mpr orientation_ne
  · rw [finTwoPoleBasis_det]
    norm_num
  · have chart := finTwoOrientedPoleBasis_mul_rankTwoBlockMatrix_mul lower a
        (fun k ↦ a k * f k) b (fun k ↦ b k * g k)
        leftPole rightPole orientation
    have left_base_eq :
        (fun k ↦ a k * f k - leftPole * a k) =
          poleChartBase a f leftPole := by rfl
    have right_base_eq :
        (fun k ↦ b k * g k - rightPole * b k) =
          poleChartBase b g rightPole := by rfl
    change _ = rankTwoBlockMatrix lower
      (poleChartBase a f leftPole) (fun k ↦ orientation * a k)
      (poleChartBase b g rightPole) b
    rw [← left_base_eq, ← right_base_eq]
    exact chart
  · have chart := finTwoOrientedPoleBasis_mul_rankTwoBlockMatrix_mul upper a
        (fun k ↦ a k * f k) b (fun k ↦ b k * g k)
        leftPole rightPole orientation
    have left_base_eq :
        (fun k ↦ a k * f k - leftPole * a k) =
          poleChartBase a f leftPole := by rfl
    have right_base_eq :
        (fun k ↦ b k * g k - rightPole * b k) =
          poleChartBase b g rightPole := by rfl
    change _ = rankTwoBlockMatrix upper
      (poleChartBase a f leftPole) (fun k ↦ orientation * a k)
      (poleChartBase b g rightPole) b
    rw [← left_base_eq, ← right_base_eq]
    exact chart
  · exact poleChartBase_mul_orientedPoleChartRatio a f leftPole orientation
      left_pole_ne
  · exact poleChartBase_mul_poleChartRatio b g rightPole right_pole_ne
  · unfold weightedMass
    apply sum_pos
    · intro k hk
      exact weight_pos k (mem_union_left upper hk)
    · exact lower_nonempty
  · unfold weightedMass
    apply sum_pos
    · intro k hk
      exact weight_pos k (mem_union_right lower hk)
    · exact upper_nonempty
  · intro k hk
    exact (weight_pos k hk).le
  · apply orientedPoleChartRatio_monovaryOn_of_matched_nonneg lower a f b g
      leftPole rightPole orientation left_pole_ne right_pole_ne
    · intro k hk
      exact weight_pos k (mem_union_left upper hk)
    · exact lower_matched_nonneg
  · apply orientedPoleChartRatio_monovaryOn_of_matched_nonneg upper a f b g
      leftPole rightPole orientation left_pole_ne right_pole_ne
    · intro k hk
      exact weight_pos k (mem_union_right lower hk)
    · exact upper_matched_nonneg
  · exact f_cross
  · exact g_cross

/-- Fully oriented and scaled separator theorem.  `orientation` chooses the
cyclic direction, while `scale` independently chooses the common sign of the
transformed left coordinates and hence of the singleton weights. -/
theorem rankTwoBlockPencil_lorentzian_of_scaled_oriented_poles
    (lower upper : Finset ι) (a f b g : ι → ℝ)
    (leftPole rightPole orientation scale : ℝ)
    (orientation_ne : orientation ≠ 0) (scale_ne : scale ≠ 0)
    (left_pole_ne : ∀ k, f k ≠ leftPole)
    (right_pole_ne : ∀ k, g k ≠ rightPole)
    (lower_nonempty : lower.Nonempty) (upper_nonempty : upper.Nonempty)
    (weight_pos : ∀ k ∈ lower ∪ upper,
      0 < scaledPoleChartBase a f leftPole scale k *
        poleChartBase b g rightPole k)
    (lower_matched_nonneg : ∀ i ∈ lower, ∀ j ∈ lower,
      0 ≤ orientation * affineRankTwoMatchedCoordinate a f b g i j)
    (upper_matched_nonneg : ∀ i ∈ upper, ∀ j ∈ upper,
      0 ≤ orientation * affineRankTwoMatchedCoordinate a f b g i j)
    (f_cross : ∀ i ∈ lower, ∀ j ∈ upper,
      orientedPoleChartRatio f leftPole orientation i ≤
        orientedPoleChartRatio f leftPole orientation j)
    (g_cross : ∀ i ∈ lower, ∀ j ∈ upper,
      poleChartRatio g rightPole i ≤ poleChartRatio g rightPole j) :
    4 * (rankTwoBlockMatrix lower a (fun k ↦ a k * f k)
          b (fun k ↦ b k * g k)).det *
        (rankTwoBlockMatrix upper a (fun k ↦ a k * f k)
          b (fun k ↦ b k * g k)).det ≤
      finTwoPencilMixed
          (rankTwoBlockMatrix lower a (fun k ↦ a k * f k)
            b (fun k ↦ b k * g k))
          (rankTwoBlockMatrix upper a (fun k ↦ a k * f k)
            b (fun k ↦ b k * g k)) ^ 2 := by
  apply rankTwoBlockPencil_lorentzian_of_projective_affine
    (finTwoScaledOrientedPoleBasis leftPole orientation scale)
    (finTwoPoleBasis rightPole)
    (rankTwoBlockMatrix lower a (fun k ↦ a k * f k)
      b (fun k ↦ b k * g k))
    (rankTwoBlockMatrix upper a (fun k ↦ a k * f k)
      b (fun k ↦ b k * g k))
    lower upper
    (scaledPoleChartBase a f leftPole scale)
    (fun k ↦ scale * orientation * a k)
    (poleChartBase b g rightPole) b
    (orientedPoleChartRatio f leftPole orientation)
    (poleChartRatio g rightPole)
  · rw [finTwoScaledOrientedPoleBasis_det]
    exact neg_ne_zero.mpr
      (mul_ne_zero (pow_ne_zero 2 scale_ne) orientation_ne)
  · rw [finTwoPoleBasis_det]
    norm_num
  · have chart := finTwoScaledOrientedPoleBasis_mul_rankTwoBlockMatrix_mul
        lower a (fun k ↦ a k * f k) b (fun k ↦ b k * g k)
        leftPole rightPole orientation scale
    have left_base_eq :
        (fun k ↦ scale * (a k * f k - leftPole * a k)) =
          scaledPoleChartBase a f leftPole scale := by rfl
    have right_base_eq :
        (fun k ↦ b k * g k - rightPole * b k) =
          poleChartBase b g rightPole := by rfl
    change _ = rankTwoBlockMatrix lower
      (scaledPoleChartBase a f leftPole scale)
      (fun k ↦ scale * orientation * a k)
      (poleChartBase b g rightPole) b
    rw [← left_base_eq, ← right_base_eq]
    exact chart
  · have chart := finTwoScaledOrientedPoleBasis_mul_rankTwoBlockMatrix_mul
        upper a (fun k ↦ a k * f k) b (fun k ↦ b k * g k)
        leftPole rightPole orientation scale
    have left_base_eq :
        (fun k ↦ scale * (a k * f k - leftPole * a k)) =
          scaledPoleChartBase a f leftPole scale := by rfl
    have right_base_eq :
        (fun k ↦ b k * g k - rightPole * b k) =
          poleChartBase b g rightPole := by rfl
    change _ = rankTwoBlockMatrix upper
      (scaledPoleChartBase a f leftPole scale)
      (fun k ↦ scale * orientation * a k)
      (poleChartBase b g rightPole) b
    rw [← left_base_eq, ← right_base_eq]
    exact chart
  · exact scaledPoleChartBase_mul_orientedPoleChartRatio a f leftPole
      orientation scale left_pole_ne
  · exact poleChartBase_mul_poleChartRatio b g rightPole right_pole_ne
  · unfold weightedMass
    apply sum_pos
    · intro k hk
      exact weight_pos k (mem_union_left upper hk)
    · exact lower_nonempty
  · unfold weightedMass
    apply sum_pos
    · intro k hk
      exact weight_pos k (mem_union_right lower hk)
    · exact upper_nonempty
  · intro k hk
    exact (weight_pos k hk).le
  · apply scaledOrientedPoleChartRatio_monovaryOn_of_matched_nonneg
      lower a f b g leftPole rightPole orientation scale
      left_pole_ne right_pole_ne
    · intro k hk
      exact weight_pos k (mem_union_left upper hk)
    · exact lower_matched_nonneg
  · apply scaledOrientedPoleChartRatio_monovaryOn_of_matched_nonneg
      upper a f b g leftPole rightPole orientation scale
      left_pole_ne right_pole_ne
    · intro k hk
      exact weight_pos k (mem_union_right lower hk)
    · exact upper_matched_nonneg
  · exact f_cross
  · exact g_cross

end Matrix
